# Server-only. Never put API keys in NEXT_PUBLIC variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional alternative provider, used only if OPENAI_API_KEY is absent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
PUBLIC_API_BASE=
ALLOWED_ORIGINS=http://localhost:3000
# Optional explicit current pricing for estimated cost display.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
